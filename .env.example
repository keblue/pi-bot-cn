# pi-bot-cn env template — copy to ~/.config/pi-bot-cn/env and chmod 600
# Fill values yourself. Never commit real secrets. Never paste keys into chat.

# DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Optional model id override (default deepseek-chat / flash per docs)
# DEEPSEEK_MODEL=deepseek-chat

# Feishu / Lark app (长连接模式；不要填 webhook 公网地址)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: verification token if using event subscription extras
# FEISHU_VERIFICATION_TOKEN=

# Owner open_id whitelist (comma-separated). Only these users can approve.
# PI_BOT_OWNER_OPEN_IDS=

# Timezone for morning brief / evening review
TZ=Asia/Shanghai
