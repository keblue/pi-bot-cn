{
  "_comment": "运行中收到新消息时怎么处理。cancel=清队列+abort+杀进程组；redirect=立即打断当前工具并 steer；followUp=做完再说；其余默认 steer（像真人插话）。正则按顺序匹配。",
  "cancelMaxLength": 12,
  "cancelPatterns": [
    "^(停|停下|停止|停一下|先停|取消|别做了|不做了|不用了|算了|打住|stop|cancel|abort)[!！。.~～ ]*$",
    "^/(abort|stop)$"
  ],
  "redirectPatterns": [
    "^(改成|改为|换成|改一下|换个|先别|别.{0,8}了[，,]|不要.{0,8}了[，,]|不对[，,]|算了[，,])",
    "^/redirect\\s"
  ],
  "followUpPatterns": [
    "^(做完|弄完|完了以后|完了之后|之后再|然后再|等你做完|顺便最后)"
  ],
  "defaultWhileBusy": "steer",
  "hardInterruptOnRedirect": true,
  "redirectWhileThinking": "abort_and_prompt",
  "showToolProgress": true,
  "idleTimeoutMinutes": 30,
  "acks": {
    "cancel": "好，停了。",
    "redirect": "收到，马上改。",
    "followUp": "好，这个做完就接着弄。",
    "steer": "",
    "restart": "刚才我重启了一下，你让我做的那件事没做完。要我接着做吗？",
    "error": "哎，刚才出了点问题没弄完（{err}）。要我再试一次吗？"
  },
  "_comment_quiet": "quietChannels 里的通道只收到自然对话：不发「收到/停了/正在执行」之类的状态消息和工具进度；打断信息只写服务器日志 interrupts.jsonl / gateway.jsonl。",
  "quietChannels": [
    "feishu"
  ],
  "approval": {
    "_comment": "危险命令执行前先问主人（飞书里是一张「可以/先别」卡片；本地通道是一句话）。超时=不做。审批期间说「停/取消」也立即生效。",
    "enabled": true,
    "timeoutMinutes": 10,
    "_modeComment": "授权模式：ask=每次询问（默认），always=始终允许（普通危险命令直接执行）。每个主人单独保存在 数据目录/approval-modes.json，重启不丢；没设置过时用环境变量 PI_APPROVAL_MODE。alwaysAskRules 里的灾难级命令在任何模式下都要问。",
    "alwaysPatterns": [
      "^(以后|之后|往后)?(都|就)?(不用|不必|别|不要)(再)?问(我)?(了)?(吧)?[!！。.~～ ]*$",
      "^(始终|总是|一直|以后都|全部|都)(允许|同意|放行)(吧)?[!！。.~～ ]*$"
    ],
    "askPatterns": [
      "^(恢复|改回|还是|改成|切回)?(每次|每一次)(都)?(询问|问(我|一下)?)(吧)?[!！。.~～ ]*$",
      "^(恢复|改回)(询问|审批)(吧)?[!！。.~～ ]*$",
      "^(以后|之后)?(还是)?(要|得)?先问(我|一下)?(再(做|执行))?(吧)?[!！。.~～ ]*$"
    ],
    "settingsPatterns": [
      "^(授权|审批|权限)(设置|模式)[?？!！。.~～ ]*$"
    ],
    "approvePatterns": [
      "^(可以|允许|同意|批准|行|好|好的|执行|执行吧|没问题|ok|okay|yes|y)[!！。.~～ ]*$"
    ],
    "denyPatterns": [
      "^(不行|不可以|拒绝|不要|别|先别|不用|不同意|no|n)[!！。.~～ ]*$"
    ],
    "rules": [
      {
        "re": "(^|[;&|`(]\\s*|\\s)sudo\\s",
        "why": "要用管理员权限（sudo）"
      },
      {
        "re": "\\brm\\s+(-[a-zA-Z]*[rRf]|.*[*?])",
        "why": "会删除文件（可能不止一个）"
      },
      {
        "re": "\\bfind\\b.*\\s-(delete|exec\\s+rm)|\\bxargs\\s+rm\\b|\\bshred\\b|\\bmkfs|\\bdd\\s+.*of=|\\btruncate\\s",
        "why": "会批量删除或覆盖数据"
      },
      {
        "re": "\\b(systemctl|service|reboot|shutdown|poweroff|crontab\\s+-r|pkill|killall)\\b|\\bkill\\s+-9",
        "why": "会改动系统服务或结束进程"
      },
      {
        "re": "\\b(chmod|chown)\\s+-R\\b|\\bmv\\s+.*[*?]|>\\s*/(etc|usr|boot|var)/",
        "why": "会批量改权限或覆盖系统文件"
      },
      {
        "re": "\\bgit\\s+(push|reset\\s+--hard|clean\\s+-[a-z]*f)",
        "why": "会改写或推送 Git 历史"
      },
      {
        "re": "\\b(curl|wget)\\b.*(\\s-(T|F|d)\\s|--data|--upload-file|--form|-X\\s*(POST|PUT|DELETE|PATCH))|\\b(scp|sftp|rsync)\\b.*\\S+:|\\b(nc|ncat|ssh)\\s",
        "why": "会把数据发送或上传到外部"
      },
      {
        "re": "(\\.env\\b|/\\.ssh/|pi-bot-cn/env|id_(rsa|ed25519)|\\.pem\\b|credentials|api[_-]?key|secret)",
        "why": "会碰到密钥或配置文件"
      },
      {
        "re": "\\b(npm\\s+publish|apt(-get)?\\s+(remove|purge))\\b",
        "why": "会发布包或卸载软件"
      }
    ],
    "protectedPathPatterns": [
      "(^|/)\\.env($|\\.)",
      "/\\.ssh/",
      "pi-bot-cn/env",
      "\\.pem$",
      "id_(rsa|ed25519)"
    ],
    "alwaysAskRules": [
      {
        "re": "\\brm\\s+(-\\S+\\s+)*-[a-zA-Z]*[rR][a-zA-Z]*\\s+(-\\S+\\s+)*[\"']?(/|~|\\$HOME|\\$\\{HOME\\}|/(etc|usr|bin|sbin|boot|lib|lib64|var|home|root|opt|srv|dev|proc|sys))/?\\*?[\"']?(\\s|;|&|\\||$)",
        "why": "会删掉整个系统或整个主目录"
      },
      {
        "re": "--no-preserve-root",
        "why": "会删掉整个系统"
      },
      {
        "re": "\\b(mkfs(\\.\\w+)?|wipefs|fdisk|sfdisk|parted|mkswap)\\b",
        "why": "会格式化或改动磁盘分区"
      },
      {
        "re": "\\bdd\\b.*\\bof=/dev/(sd|hd|vd|xvd|nvme|mmcblk|disk|mapper)",
        "why": "会直接覆盖整块磁盘"
      },
      {
        "re": ">\\s*/dev/(sd|hd|vd|xvd|nvme|mmcblk)",
        "why": "会直接覆盖整块磁盘"
      },
      {
        "re": "\\b(shutdown|reboot|poweroff|halt)\\b|\\binit\\s+[06]\\b|\\bsystemctl\\s+(poweroff|reboot|halt|kexec)\\b",
        "why": "会关机或重启服务器"
      },
      {
        "re": "\\bsystemctl\\s+(stop|disable|mask|kill)\\s+(\\S+\\s+)*pi-bot-cn",
        "why": "会把我自己停掉"
      },
      {
        "re": "(\\.config/pi-bot-cn|pi-bot-cn/env|(^|[\\s/'\"])\\.env\\b|/\\.ssh/|authorized_keys|id_(rsa|ed25519|ecdsa)|\\.pem\\b)",
        "why": "会碰到我自己的密钥或登录配置"
      },
      {
        "re": ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\}\\s*;\\s*:",
        "why": "会把服务器拖垮（fork 炸弹）"
      },
      {
        "re": "\\b(chmod|chown)\\s+(-\\S+\\s+)*-R\\s+\\S+\\s+/(\\s|$)",
        "why": "会改掉整个系统的权限"
      }
    ],
    "_alwaysAskComment": "灾难级命令：就算主人设了「始终允许」也每次都问（也不显示「以后都允许」按钮）。write/edit 改 .env、.ssh、密钥文件同样属于这一类。"
  }
}
