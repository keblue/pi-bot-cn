# pi-bot-cn env 模板 —— 复制到 ~/.config/pi-bot-cn/env 并 chmod 600
# 值自己填；不要提交真实密钥；不要把密钥贴进任何聊天。

# 模型（二选一或都填；PIBOT_PROVIDER / PIBOT_MODEL 决定用哪个）
MINIMAX_CN_API_KEY=
DEEPSEEK_API_KEY=
PIBOT_PROVIDER=minimax-cn
PIBOT_MODEL=MiniMax-M3.1-Flash

# 飞书自建应用（长连接模式；不要填 webhook 公网地址）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
# 主人 open_id 白名单（逗号分隔）。不填时只响应私聊，并在日志 feishu_owner_hint 里记录发消息人的 open_id
# PI_BOT_OWNER_OPEN_IDS=

# 记忆（pi-memory 0.4.2）
PI_MEMORY_SNAPSHOT=stable

TZ=Asia/Shanghai
